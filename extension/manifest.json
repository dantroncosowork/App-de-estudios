{
  "manifest_version": 3,
  "name": "Estudio Deep Link",
  "version": "1.0.0",
  "description": "Captura deep links con minuto exacto (YouTube, Coursera), citas (Gemini, Claude, ChatGPT, webs) y recortes de pantalla para organizar tus estudios.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir Estudio Deep Link",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Abrir panel lateral de Estudio Deep Link"
    },
    "open-capture": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Capturar pestaña actual (minuto y cita) en Estudio"
    }
  }
}
